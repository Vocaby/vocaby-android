<?xml version="1.0" encoding="utf-8"?>
<resources>
    <declare-styleable name="DescriptiveButtonView">
        <attr name="android:enabled" />
        <attr name="headerText" format="string" />
        <attr name="descriptionText" format="string" />
        <attr name="headerColor" format="reference" />
        <attr name="descriptionColor" format="reference" />
    </declare-styleable>
    <declare-styleable name="SearchView">
        <attr name="searchBarWidth" format="dimension"/>
        <attr name="searchBarMarginTop" format="dimension"/>
        <attr name="searchBarMarginLeft" format="dimension"/>
        <attr name="searchBarMarginRight" format="dimension"/>
        <attr name="searchInputTextSize" format="dimension"/>
        <attr name="dismissFocusOnItemSelection" format="boolean"/>
        <attr name="searchHint" format="string"/>
        <attr name="dismissOnOutsideTouch" format="boolean"/>
        <attr name="suggestionsListAnimDuration" format="integer"/>
        <attr name="close_search_on_keyboard_dismiss" format="boolean"/>
        <attr name="dimBackground" format="boolean"/>
        <attr name="backgroundColor" format="color"/>
        <attr name="clearBtnColor" format="color"/>
        <attr name="viewTextColor" format="color"/>
        <attr name="viewSearchInputTextColor" format="color"/>
        <attr name="hintTextColor" format="color"/>
        <attr name="leftActionColor" format="color"/>
    </declare-styleable>
</resources>