<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.VocabyAndroid.Splash" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:windowBackground">@drawable/splash</item>
        <item name="colorPrimary">@color/colorPrimaryAccent</item>
        <item name="colorPrimaryVariant">@color/colorPrimaryAccent</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">@color/white</item>
    </style>

    <!-- Base application theme. -->
    <style name="Theme.VocabyAndroid" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/colorPrimaryAccent</item>
        <item name="colorPrimaryVariant">@color/colorPrimaryAccent</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="android:textColorHint">@color/gray</item>
        <item name="android:windowBackground">@color/white</item>

        <!-- Status bar color. -->
        <item name="android:statusBarColor" tools:targetApi="l">@color/colorPrimaryAccent</item>
        <item name="colorControlActivated">@color/colorPrimary</item>
        <item name="preferenceTheme">@style/Theme.VocabyAndroid.PreferenceThemeOverlay</item>

        <item name="colorAccent">@color/colorPrimaryAccent</item>

        <item name="android:fontFamily">@font/sourcesanspro_regular</item>
        <item name="android:textColor">@color/black</item>

        <item name="materialAlertDialogTheme">@style/Theme.VocabyAndroid.MaterialDialogAlert</item>
        <item name="bottomSheetDialogTheme">@style/Theme.VocabyAndroid.BottomSheetDialog</item>

        <item name="alertDialogTheme">@style/AlertDialogStyle</item>
    </style>

    <style name="Theme.VocabyAndroid.TextInputEditText" parent="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu">
        <!-- left and right padding -->
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:paddingLeft">12dp</item>
        <item name="android:paddingRight">12dp</item>

        <!-- top and bottom padding -->
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
    </style>

    <style name="AlertDialogStyle" parent="ThemeOverlay.AppCompat.Dialog.Alert">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryAccent</item>
        <item name="colorAccent">@color/colorPrimary</item>
        <item name="android:background">@drawable/box_white</item>
        <item name="android:textColorSecondary">@color/gray</item>
        <item name="textColorAlertDialogListItem">@color/black</item>
        <item name="android:windowTitleStyle">@style/Theme.VocabyAndroid.AlertDialog.Title</item>
        <item name="android:textAppearanceMedium">@style/Theme.VocabyAndroid.AlertDialog.Title</item>
        <item name="buttonBarPositiveButtonStyle">@style/Theme.VocabyAndroid.MaterialDialogAlert.Positive</item>
        <item name="buttonBarNegativeButtonStyle">@style/Theme.VocabyAndroid.MaterialDialogAlert.Neutral</item>
    </style>

    <style name="Theme.VocabyAndroid.AlertDialog.Title" parent="@style/MaterialAlertDialog.MaterialComponents.Title.Text">
        <item name="android:fontFamily">@font/sourcesanspro_semibold</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/black</item>
    </style>

    <style name="Theme.VocabyAndroid.PreferenceThemeOverlay" parent="@style/PreferenceThemeOverlay">
        <item name="android:layout">@layout/fragment_profile_notifications</item>
        <item name="preferenceCategoryStyle">@style/Theme.VocabyAndroid.PreferenceCategory</item>
        <item name="dialogPreferenceStyle">@style/Theme.VocabyAndroid.PreferenceDialog</item>
        <item name="switchPreferenceStyle">@style/Theme.VocabyAndroid.PreferenceSwitch</item>
        <item name="switchPreferenceCompatStyle">@style/Theme.VocabyAndroid.PreferenceSwitchCompat</item>
    </style>

    <style name="Theme.VocabyAndroid.PreferenceCategory" parent="@style/Preference.Category">
        <item name="android:layout">@layout/custom_preference_category</item>
    </style>


    <style name="Theme.VocabyAndroid.PreferenceSwitch" parent="@style/Preference.SwitchPreference.Material">
        <item name="android:layout">@layout/custom_preference</item>
    </style>

    <style name="Theme.VocabyAndroid.PreferenceSwitchCompat" parent="@style/Preference.SwitchPreferenceCompat.Material">
        <item name="android:layout">@layout/custom_preference</item>
    </style>

    <style name="Theme.VocabyAndroid.PreferenceDialog" parent="@style/Preference.DialogPreference.Material">
        <item name="android:layout">@layout/custom_preference</item>
    </style>

    <style name="Theme.VocabyAndroid.MaterialDialogAlert" parent="ThemeOverlay.MaterialComponents.MaterialAlertDialog">
        <item name="android:fontFamily">@font/sourcesanspro_semibold</item>
        <item name="android:background">@color/white</item>
        <item name="materialAlertDialogTitleTextStyle">@style/Theme.VocabyAndroid.MaterialDialogAlert.Title</item>
        <item name="materialAlertDialogBodyTextStyle">@style/Theme.VocabyAndroid.MaterialDialogAlert.Body</item>
        <item name="buttonBarPositiveButtonStyle">@style/Theme.VocabyAndroid.MaterialDialogAlert.Negative</item>
        <item name="buttonBarNegativeButtonStyle">@style/Theme.VocabyAndroid.MaterialDialogAlert.Neutral</item>
        <item name="shapeAppearance">@style/ShapeAppearance.VocabyAndroid.SmallComponent</item>
    </style>

    <style name="Theme.VocabyAndroid.MaterialDialogAlert.Title" parent="@style/MaterialAlertDialog.MaterialComponents.Title.Text">
        <item name="android:textColor">@color/black</item>
    </style>

    <style name="Theme.VocabyAndroid.MaterialDialogAlert.Body" parent="@style/MaterialAlertDialog.MaterialComponents.Body.Text">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/dark_gray</item>
    </style>

    <style name="Theme.VocabyAndroid.MaterialDialogAlert.Positive" parent="@style/Widget.MaterialComponents.Button.TextButton.Dialog">
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">12sp</item>
        <item name="android:fontFamily">@font/sourcesanspro_black</item>
        <item name="backgroundTint">@color/colorPrimary</item>
        <item name="shapeAppearance">@style/ShapeAppearance.VocabyAndroid.SmallComponent</item>
    </style>

    <style name="Theme.VocabyAndroid.MaterialDialogAlert.Negative" parent="@style/Widget.MaterialComponents.Button.TextButton.Dialog">
        <item name="android:textColor">@color/colorHeadline</item>
        <item name="android:textSize">12sp</item>
        <item name="android:fontFamily">@font/sourcesanspro_black</item>
        <item name="backgroundTint">@color/colorHeadlineSoft</item>
        <item name="shapeAppearance">@style/ShapeAppearance.VocabyAndroid.SmallComponent</item>
    </style>

    <style name="Theme.VocabyAndroid.MaterialDialogAlert.Neutral" parent="@style/Widget.MaterialComponents.Button.TextButton.Dialog">
        <item name="android:textSize">12sp</item>
        <item name="android:fontFamily">@font/sourcesanspro_black</item>
        <item name="android:textColor">@color/black</item>
    </style>

    <style name="ShapeAppearance.VocabyAndroid.SmallComponent" parent="ShapeAppearance.MaterialComponents.SmallComponent">
        <item name="cornerSize">@dimen/radius</item>
    </style>

    <style name="Theme.VocabyAndroid.TextHeadline" parent="Widget.AppCompat.TextView">
        <item name="android:fontFamily">@font/sourcesanspro_black</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/black</item>
    </style>

    <style name="Theme.VocabyAndroid.TextHeader" parent="Widget.AppCompat.TextView">
        <item name="android:fontFamily">@font/playfairdisplay_black</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <style name="Theme.VocabyAndroid.Button" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:background">@drawable/button_background</item>
        <item name="android:textSize">12sp</item>
        <item name="android:fontFamily">@font/sourcesanspro_black</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:padding">12dp</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="Theme.VocabyAndroid.NavButton" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:background">@color/white</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:textSize">12sp</item>
        <item name="android:fontFamily">@font/sourcesanspro_black</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">@color/black</item>
    </style>

    <style name="Theme.VocabyAndroid.MaterialToggleButton" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="iconPadding">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:fontFamily">@font/sourcesanspro_black</item>
        <item name="android:textSize">8sp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingLeft">8dp</item>
        <item name="android:paddingRight">8dp</item>
        <item name="android:paddingTop">4dp</item>
        <item name="android:paddingBottom">4dp</item>
        <item name="android:minWidth">14dp</item>
        <item name="android:minHeight">14dp</item>
        <item name="android:colorAccent">@color/colorPrimary</item>
    </style>

    <style name="Theme.VocabyAndroid.ProfileButton" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:background">?attr/selectableItemBackground</item>
        <item name="iconTint">@color/colorPrimaryAccent</item>
        <item name="android:fontFamily">@font/sourcesanspro_semibold</item>
        <item name="android:textSize">12sp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingStart">@dimen/container_side_margin</item>
        <item name="android:paddingEnd">@dimen/container_side_margin</item>
        <item name="android:textColor">@color/black</item>
        <item name="textAllCaps">false</item>
        <item name="android:drawablePadding">28dp</item>
        <item name="android:gravity">left|center_vertical</item>
    </style>

    <style name="Theme.VocabyAndroid.BottomSheetDialog"
        parent="Theme.Design.Light.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/AppModalStyle</item>
    </style>

    <style name="AppModalStyle" parent="Widget.Design.BottomSheet.Modal">
        <item name="android:background">@drawable/bottom_sheet_dialog</item>
    </style>
</resources>