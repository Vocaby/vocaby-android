<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/dictionary_fragment"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".ui.ProfileHomeFragment">
    <LinearLayout
        android:id="@+id/vocaby_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:orientation="horizontal"
            android:background="@drawable/box_bottom_stroke_white"
            android:gravity="center">
            <ImageView
                android:id="@+id/vocaby_header_logo"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginStart="@dimen/container_side_margin"
                android:contentDescription="@string/app_logo"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:srcCompat="@drawable/ic_vocaby_logo"
                tools:ignore="ImageContrastCheck" />

            <TextView
                android:id="@+id/header_text"
                style="@style/Theme.VocabyAndroid.TextHeadline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/profile"
                android:textColor="@color/colorPrimary"
                android:textSize="16sp" />

            <Space
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

            <TextView
                style="@style/Theme.VocabyAndroid.TextHeaderWithShadow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/container_side_margin"
                android:text="@string/hi_vocabler"
                android:textColor="@color/colorPrimaryAccent"
                android:textSize="15sp" />
        </LinearLayout>

    </LinearLayout>

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginStart="@dimen/container_side_margin"
        android:layout_marginEnd="@dimen/container_side_margin"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp"
        app:cardCornerRadius="@dimen/radius"
        app:cardElevation="4dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/green_gradient">
            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginStart="@dimen/card_content_margin"
                android:src="@drawable/ic_notifications"
                app:tint="@color/white"
                android:contentDescription="@string/notification_icon_desc" />
            <TextView
                android:id="@+id/notification_type"
                style="@style/Theme.VocabyAndroid.TextHeadline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/notification_type_placeholder"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:layout_marginStart="@dimen/card_content_margin" />
            <TextView
                android:id="@+id/notification_title"
                style="@style/Theme.VocabyAndroid.TextHeadline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/notification_title_placeholder"
                android:textColor="@color/white"
                android:textSize="10sp"
                android:layout_marginStart="@dimen/card_content_margin"
                tools:ignore="SmallSp" />
            <Space
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />
            <TextView
                android:id="@+id/notification_date"
                style="@style/Theme.VocabyAndroid.TextHeadline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/notification_date_placeholder"
                android:textColor="@color/white"
                android:textSize="10sp"
                android:layout_marginEnd="@dimen/card_content_margin"
                tools:ignore="SmallSp" />
        </LinearLayout>

    </androidx.cardview.widget.CardView>

    <FrameLayout
        android:id="@+id/profile_fragment_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingBottom="8dp"/>
</LinearLayout>