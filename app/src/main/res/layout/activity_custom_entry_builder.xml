<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".feature_dictionary_custom.presentation.builder.entry_builder.EntryBuilderActivity"
    android:orientation="vertical"
    android:clickable="true"
    android:focusable="true"
    android:focusableInTouchMode="true">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/linearLayout4"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/box_white_bottom_stroke_gray"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/back_button"
            style="@style/Theme.VocabyAndroid.NavButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/nav_close"
            android:paddingTop="@dimen/container_gap_margin"
            android:paddingBottom="@dimen/container_gap_margin"
            android:paddingStart="@dimen/container_side_margin"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/editor_header"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/sourcesanspro_semibold"
            android:textColor="@color/black"
            android:textSize="14sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ProgressBar
            android:id="@+id/save_progress_bar"
            style="?android:attr/progressBarStyle"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:indeterminateTint="@color/colorPrimary"
            android:layout_marginEnd="8dp"
            android:visibility="invisible"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/save_button"
            app:layout_constraintTop_toTopOf="parent" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/save_button"
            style="@style/Theme.VocabyAndroid.NavButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingTop="@dimen/container_gap_margin"
            android:paddingBottom="@dimen/container_gap_margin"
            android:paddingEnd="@dimen/container_side_margin"
            android:text="@string/nav_save"
            android:textColor="@color/colorPrimary"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:ignore="TextContrastCheck" />
    </androidx.constraintlayout.widget.ConstraintLayout>
    <LinearLayout
        android:id="@+id/linearLayout2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_marginStart="@dimen/container_side_margin"
        android:layout_marginEnd="@dimen/container_side_margin"
        android:layout_marginTop="@dimen/container_gap_margin"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/linearLayout4">

        <TextView
            style="@style/Theme.VocabyAndroid.TextHeadline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/entry_header"
            android:textColor="@color/dark_gray"
            android:textSize="12sp" />

        <Space
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />
    </LinearLayout>
    <me.grantland.widget.AutofitTextView
        xmlns:autofit="http://schemas.android.com/apk/res-auto"
        style="@style/Theme.VocabyAndroid.TextHeader"
        android:id="@+id/entry_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/container_side_margin"
        android:layout_marginEnd="@dimen/container_side_margin"
        android:textAllCaps="true"
        android:textColor="@color/black"
        android:maxLines="3"
        android:textSize="28sp"
        autofit:minTextSize="14sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/linearLayout2" />

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/container_gap_margin"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/entry_header">
        <com.google.android.material.appbar.AppBarLayout
            android:id="@+id/entry_app_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/white"
            app:liftOnScroll="true"
            app:liftOnScrollTargetViewId="@id/custom_entry_group_container"
            app:elevation="0dp"
            android:gravity="center_vertical">
            <com.google.android.material.appbar.CollapsingToolbarLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_scrollFlags="scroll|enterAlwaysCollapsed"
                android:background="@drawable/box_white_bottom_stroke_gray"
                android:paddingStart="@dimen/container_side_margin"
                android:paddingEnd="@dimen/container_side_margin">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/container_side_margin"
                    android:orientation="vertical">
                    <TextView
                        style="@style/Theme.VocabyAndroid.TextHeadline"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/pronunciation"
                        android:textColor="@color/dark_gray"
                        android:textSize="12sp" />
                    <EditText
                        android:id="@+id/pronunciation_input"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/container_gap_margin"
                        android:autofillHints="Enter a pronunciation"
                        android:background="@drawable/text_input_box"
                        android:fontFamily="@font/sourcesanspro_regular"
                        android:hint="@string/enter_a_pronunciation"
                        android:imeOptions="actionDone"
                        android:inputType="text"
                        android:padding="12dp"
                        android:textColor="@color/black"
                        android:textSize="14sp" />
                </LinearLayout>
            </com.google.android.material.appbar.CollapsingToolbarLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:paddingTop="@dimen/container_gap_margin"
                android:paddingBottom="@dimen/container_gap_margin"
                android:paddingStart="@dimen/container_side_margin"
                android:paddingEnd="@dimen/container_side_margin"
                android:orientation="horizontal">
                <TextView
                    style="@style/Theme.VocabyAndroid.TextHeadline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/custom_definition_group_header"
                    android:textColor="@color/dark_gray"
                    android:textSize="12sp" />
                <TextView
                    android:id="@+id/group_header_alert"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:fontFamily="@font/sourcesanspro_semibold"
                    android:labelFor="@+id/definition_edit"
                    android:text="@string/group_header_alert"
                    android:textColor="@color/colorHeadline"
                    android:textSize="12sp"
                    android:visibility="invisible" />

                <Space
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1" />
                <TextView
                    style="@style/Theme.VocabyAndroid.TextHeadline"
                    android:id="@+id/help_button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:text="@string/help"
                    android:textColor="@color/colorPrimary"
                    android:gravity="center"
                    android:drawablePadding="6dp"
                    app:drawableStartCompat="@drawable/ic_help"
                    app:drawableTint="@color/colorPrimary" />
            </LinearLayout>
        </com.google.android.material.appbar.AppBarLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/custom_entry_group_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:background="@color/white"
            android:paddingStart="@dimen/container_side_margin"
            android:paddingTop="@dimen/container_gap_margin"
            android:paddingEnd="@dimen/container_side_margin"
            android:paddingBottom="@dimen/container_gap_margin"
            android:requiresFadingEdge="none"
            app:layout_behavior="@string/appbar_scrolling_view_behavior"/>

        <LinearLayout
            android:id="@+id/empty_card"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="@drawable/box_gray_stroked_dash_gray"
            android:layout_marginStart="@dimen/container_side_margin"
            android:layout_marginEnd="@dimen/container_side_margin"
            android:layout_marginTop="@dimen/container_gap_margin"
            android:orientation="horizontal"
            app:layout_behavior="@string/appbar_scrolling_view_behavior">
            <TextView
                style="@style/Theme.VocabyAndroid.TextHeadline"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="@string/empty"
                android:textAllCaps="true"
                android:textColor="@color/gray" />
        </LinearLayout>

        <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
            android:id="@+id/add_def_group_button"
            style="@style/Widget.App.ExtendedFloatingActionButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="16dp"
            android:text="@string/custom_group_add_button"
            android:theme="@style/Theme.VocabyAndroid"
            app:backgroundTint="@color/colorPrimary"
            app:elevation="1dp"
            app:icon="@drawable/ic_add"
            app:iconPadding="4dp"
            app:iconTint="@color/white"
            app:layout_anchor="@id/custom_entry_group_container"
            app:layout_anchorGravity="bottom|end"
            app:layout_behavior="com.google.android.material.behavior.HideBottomViewOnScrollBehavior"
            app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.VocabyAndroid.FAB" />
    </androidx.coordinatorlayout.widget.CoordinatorLayout>
</androidx.constraintlayout.widget.ConstraintLayout>