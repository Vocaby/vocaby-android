<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:tools="http://schemas.android.com/tools"
    android:background="@drawable/white_background"
    android:orientation="vertical"
    android:padding="8dp"
    xmlns:android="http://schemas.android.com/apk/res/android">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/close_button"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/sourcesanspro_semibold"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:text="@string/close"
            android:textColor="@color/dark_gray"
            android:textSize="12sp"
            tools:ignore="SmallSp" />

        <Space
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/sourcesanspro_semibold"
            android:text="New Definition"
            android:textColor="@color/colorPrimary_header"
            android:textSize="14sp" />

        <Space
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/create_definition_button"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/sourcesanspro_semibold"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:text="@string/add"
            android:textColor="@color/colorPrimary_header"
            android:textSize="12sp"
            tools:ignore="SmallSp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/container_side_margin"
        android:padding="12dp"
        android:orientation="vertical">
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/definition_header"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/sourcesanspro_semibold"
                android:textSize="12sp"
                android:layout_marginBottom="8dp"
                android:labelFor="@+id/definition_edit"
                android:text="@string/definition_header" />

            <TextView
                android:id="@+id/definition_header_alert"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/sourcesanspro_semibold"
                android:textColor="@color/color_tertiary"
                android:textSize="12sp"
                android:layout_marginStart="12dp"
                android:visibility="invisible"
                android:layout_marginBottom="8dp"
                android:labelFor="@+id/definition_edit"
                android:text="@string/definition_alert" />
        </LinearLayout>

        <EditText
            android:id="@id/definition_edit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="12dp"
            android:importantForAutofill="no"
            android:imeOptions="actionDone"
            android:fontFamily="@font/sourcesanspro_regular"
            android:background="@drawable/gray_background"
            android:textSize="14sp"
            android:inputType="text"/>

        <TextView
            android:labelFor="@id/example_edit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="8dp"
            android:fontFamily="@font/sourcesanspro_semibold"
            android:textSize="12sp"
            android:text="@string/example_header" />

        <EditText
            android:id="@+id/example_edit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:importantForAutofill="no"
            android:imeOptions="actionDone"
            android:padding="12dp"
            android:background="@drawable/gray_background"
            android:textSize="14sp"
            android:inputType="text" />
    </LinearLayout>
</LinearLayout>