<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context=".feature_user.presentation.ui.ProfileHomeFragment">
    <LinearLayout
        android:id="@+id/vocaby_header"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            style="@style/Theme.VocabyAndroid.TextHeadline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:layout_marginStart="@dimen/container_side_margin"
            android:text="@string/nav_profile"
            android:textColor="@color/colorPrimary"
            android:textSize="14sp"
            android:drawablePadding="8dp"
            app:drawableStartCompat="@drawable/ic_vocaby_logo_sm" />

        <Space
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />

        <TextView
            style="@style/Theme.VocabyAndroid.TextHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/container_side_margin"
            android:text="@string/hi_vocabler"
            android:textAllCaps="false"
            android:textColor="@color/colorPrimaryAccent"
            android:textSize="15sp" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginStart="@dimen/container_side_margin"
        android:layout_marginEnd="@dimen/container_side_margin">
        <TextView
            style="@style/Theme.VocabyAndroid.TextHeadline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/chart_header"
            android:layout_marginEnd="6dp"
            android:textColor="@color/gray" />

        <Space
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/chart_toggle_button"
            style="@style/Theme.VocabyAndroid.MaterialToggleButton"
            android:layout_width="wrap_content"
            android:minWidth="74dp"
            android:layout_height="wrap_content"
            android:checkable="true"
            android:gravity="center"
            android:text="@string/chart_toggle_monthly"
            android:textSize="8sp"
            android:textColor="@color/colorPrimary"
            app:backgroundTint="@color/white"
            app:cornerRadius="@dimen/radius"
            app:icon="@drawable/toggle_chart"
            app:iconPadding="4dp"
            app:iconSize="12dp"
            app:iconTint="@color/colorPrimary"
            app:rippleColor="@color/colorSecondary"
            app:strokeColor="@color/colorPrimary"
            tools:ignore="TouchTargetSizeCheck" />
    </LinearLayout>
    <include layout="@layout/chart_placeholder" />
    <LinearLayout
        android:id="@+id/chart_container"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        <TextView
            android:id="@+id/favorite_entry"
            style="@style/Theme.VocabyAndroid.TextHeader"
            android:layout_width="match_parent"
            android:layout_height="28dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:layout_marginStart="@dimen/container_side_margin"
            android:layout_marginEnd="@dimen/container_side_margin"
            app:autoSizeMinTextSize="16sp"
            app:autoSizeStepGranularity="1sp"
            app:autoSizeTextType="uniform"/>
        <com.github.mikephil.charting.charts.BarChart
            android:id="@+id/bar_chart"
            android:layout_width="match_parent"
            android:layout_height="130dp"
            android:layout_gravity="center"
            android:clipToPadding="false"
            android:clipChildren="false"
            android:layout_marginStart="@dimen/container_side_margin"
            android:layout_marginEnd="@dimen/container_side_margin" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="6dp"
        android:layout_marginStart="@dimen/container_side_margin"
        android:layout_marginEnd="@dimen/container_side_margin">
        <View
            android:id="@+id/indicator"
            android:layout_width="6dp"
            android:layout_height="6dp"
            android:layout_gravity="center"
            android:background="@drawable/indicator"/>
        <TextView
            android:id="@+id/chart_placeholder_alert"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginStart="6dp"
            android:fontFamily="@font/sourcesanspro_semibold"
            android:textColor="@color/colorHeadline"
            android:textSize="10sp"
            tools:ignore="SmallSp" />
        <Space
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:textSize="8sp"
            android:fontFamily="@font/sourcesanspro_regular"
            android:textColor="@color/black"
            android:text="@string/chart_guide"
            tools:ignore="SmallSp" />
    </LinearLayout>
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/notification_button"
        style="@style/Theme.VocabyAndroid.ProfileButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/notifications"
        android:drawableStart="@drawable/ic_boxed_notification"
        android:drawableEnd="@drawable/ic_chevron_right"/>
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/data_management_button"
        style="@style/Theme.VocabyAndroid.ProfileButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/nav_data_management"
        android:drawableStart="@drawable/ic_boxed_data_management"
        android:drawableEnd="@drawable/ic_chevron_right"/>
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/support_button"
        style="@style/Theme.VocabyAndroid.ProfileButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/nav_support"
        android:drawableStart="@drawable/ic_boxed_support"
        android:drawableEnd="@drawable/ic_chevron_right"/>
    <Space
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:layout_weight="1" />
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/danger_zone_button"
        style="@style/Theme.VocabyAndroid.ProfileButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="@string/nav_danger_zone"
        android:drawableStart="@drawable/ic_boxed_danger_zone"
        android:drawableEnd="@drawable/ic_chevron_right"/>
</LinearLayout>