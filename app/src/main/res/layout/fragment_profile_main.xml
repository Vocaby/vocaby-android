<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/profile_fragment"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context=".ui.ProfileHomeFragment">
    <androidx.cardview.widget.CardView
        android:id="@+id/cardView"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="@dimen/card_content_margin"
        android:layout_marginStart="@dimen/container_side_margin"
        android:layout_marginEnd="@dimen/container_side_margin"
        android:layout_marginBottom="@dimen/card_content_margin"
        app:cardCornerRadius="@dimen/radius"
        app:cardElevation="4dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="45dp"
            android:background="@drawable/green_gradient"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginStart="@dimen/card_content_margin"
                android:contentDescription="@string/notification_icon_desc"
                android:src="@drawable/ic_notifications"
                app:tint="@color/white" />

            <TextView
                android:id="@+id/notification_type"
                style="@style/Theme.VocabyAndroid.TextHeadline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/card_content_margin"
                android:text="@string/notification_type_placeholder"
                android:textColor="@color/white"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/notification_title"
                style="@style/Theme.VocabyAndroid.TextHeadline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/card_content_margin"
                android:text="@string/notification_title_placeholder"
                android:textColor="@color/white"
                android:textSize="10sp"
                tools:ignore="SmallSp" />

            <Space
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/notification_date"
                style="@style/Theme.VocabyAndroid.TextHeadline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/card_content_margin"
                android:text="@string/notification_date_placeholder"
                android:textColor="@color/white"
                android:textSize="10sp"
                tools:ignore="SmallSp" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/notification_button"
        style="@style/Theme.VocabyAndroid.ProfileButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/notifications"
        android:drawableStart="@drawable/ic_boxed_notification"
        android:drawableEnd="@drawable/ic_chevron_right"/>
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/data_management_button"
        style="@style/Theme.VocabyAndroid.ProfileButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/nav_data_management"
        android:drawableStart="@drawable/ic_boxed_data_management"
        android:drawableEnd="@drawable/ic_chevron_right"/>
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/support_button"
        style="@style/Theme.VocabyAndroid.ProfileButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/nav_support"
        android:drawableStart="@drawable/ic_boxed_support"
        android:drawableEnd="@drawable/ic_chevron_right"/>
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/feedback_button"
        style="@style/Theme.VocabyAndroid.ProfileButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/nav_feedback_button"
        android:drawableStart="@drawable/ic_boxed_feedback"
        android:drawableEnd="@drawable/ic_chevron_right"/>
    <Space
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:layout_weight="1" />
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/danger_zone_button"
        style="@style/Theme.VocabyAndroid.ProfileButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/nav_danger_zone"
        android:drawableStart="@drawable/ic_boxed_danger_zone"
        android:drawableEnd="@drawable/ic_chevron_right"/>
</LinearLayout>