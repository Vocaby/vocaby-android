<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/very_light_gray"
    tools:context=".feature_profile.presentation.profile.ProfileHomeFragment">
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardElevation="1dp"
        android:layout_marginBottom="@dimen/container_gap_margin">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="@dimen/container_side_margin"
            android:background="@color/white">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginStart="@dimen/container_side_margin"
                android:layout_marginEnd="@dimen/container_side_margin"
                android:paddingBottom="8dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical">
                    <TextView
                        style="@style/Theme.VocabyAndroid.TextSubHeader"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/chart_header"
                        android:textColor="@color/gray" />
                    <Space
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"/>
                    <TextView
                        android:id="@+id/chart_placeholder_alert"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:fontFamily="@font/sourcesanspro_semibold"
                        android:textColor="@color/colorHeadline"
                        android:textSize="10sp"
                        tools:ignore="SmallSp" />
                    <View
                        android:id="@+id/indicator"
                        android:layout_width="6dp"
                        android:layout_height="6dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/indicator"/>
                </LinearLayout>
                <TextView
                    android:id="@+id/favorite_entry"
                    style="@style/Theme.VocabyAndroid.TextHeader"
                    android:layout_width="match_parent"
                    android:layout_height="28dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/colorPrimaryAccent"
                    app:autoSizeMinTextSize="16sp"
                    app:autoSizeStepGranularity="1sp"
                    app:autoSizeTextType="uniform"/>
            </LinearLayout>
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <include layout="@layout/placeholder_chart" />
                <com.github.mikephil.charting.charts.BarChart
                    android:id="@+id/bar_chart"
                    android:visibility="invisible"
                    android:layout_width="match_parent"
                    android:layout_height="130dp"
                    android:layout_gravity="center"
                    android:clipToPadding="false"
                    android:clipChildren="false"
                    android:layout_marginStart="@dimen/container_side_margin"
                    android:layout_marginEnd="@dimen/container_side_margin" />
            </FrameLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_vertical"
                android:weightSum="3"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:layout_marginBottom="@dimen/container_gap_margin"
                android:layout_marginStart="@dimen/container_side_margin"
                android:layout_marginEnd="@dimen/container_side_margin">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="6dp">
                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/ic_bookmark_saved"
                        app:tint="@color/gray"
                        android:layout_marginEnd="@dimen/icon_gap_margin"
                        android:contentDescription="@string/user_saves" />
                    <TextView
                        android:id="@+id/save_counter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/sourcesanspro_semibold"
                        android:gravity="center_horizontal"
                        android:text="@string/dash"
                        android:textColor="@color/black"
                        android:textSize="@dimen/profile_counter_size"
                        android:maxLines="1"
                        android:ellipsize="end"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="11sp"
                        android:layout_marginStart="6dp"
                        android:fontFamily="@font/sourcesanspro_regular"
                        android:textColor="@color/black"
                        android:gravity="center_horizontal"
                        android:text="@string/nav_saves"/>
                    <View
                        android:layout_width="4dp"
                        android:layout_height="4dp"
                        android:layout_marginStart="8dp"
                        android:layout_marginEnd="6dp"
                        android:backgroundTint="@color/black"
                        android:background="@drawable/indicator"/>
                    <TextView
                        android:id="@+id/collection_counter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/black"
                        android:fontFamily="@font/sourcesanspro_semibold"
                        android:gravity="center_horizontal"
                        android:textSize="@dimen/profile_counter_size"
                        android:text="@string/dash"
                        android:maxLines="1"
                        android:ellipsize="end"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/black"
                        android:textSize="11sp"
                        android:layout_marginStart="6dp"
                        android:fontFamily="@font/sourcesanspro_regular"
                        android:gravity="center_horizontal"
                        android:text="@string/collections"/>

                    <Space
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"/>
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/chart_toggle_button"
                        style="@style/Theme.VocabyAndroid.MaterialToggleButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:checkable="true"
                        android:gravity="center"
                        android:minWidth="74dp"
                        android:text="@string/chart_toggle_monthly"
                        android:textColor="@color/colorPrimary"
                        android:textSize="8sp"
                        android:theme="@style/Theme.VocabyAndroid"
                        app:backgroundTint="@color/white"
                        app:cornerRadius="@dimen/radius"
                        app:icon="@drawable/toggle_chart"
                        app:iconPadding="4dp"
                        app:iconSize="12dp"
                        app:iconTint="@color/colorPrimary"
                        app:rippleColor="@color/colorSecondary"
                        app:strokeColor="@color/colorPrimary"
                        tools:ignore="SmallSp,TouchTargetSizeCheck" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/ic_entry"
                        android:scaleX="0.9"
                        android:scaleY="0.9"
                        app:tint="@color/gray"
                        android:layout_marginEnd="@dimen/icon_gap_margin"
                        android:contentDescription="@string/user_entries" />
                    <TextView
                        android:id="@+id/entry_counter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/black"
                        android:fontFamily="@font/sourcesanspro_semibold"
                        android:gravity="center_horizontal"
                        android:textSize="@dimen/profile_counter_size"
                        android:text="@string/dash"
                        android:maxLines="1"
                        android:ellipsize="end" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/black"
                        android:fontFamily="@font/sourcesanspro_regular"
                        android:textSize="11sp"
                        android:layout_marginStart="6dp"
                        android:gravity="center_horizontal"
                        android:text="@string/custom_entries"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardElevation="1dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/white"
            android:paddingTop="@dimen/container_gap_margin"
            android:paddingBottom="@dimen/container_gap_margin"
            android:orientation="vertical">
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/notification_button"
                style="@style/Theme.VocabyAndroid.ProfileButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/nav_setting"
                android:drawableStart="@drawable/ic_boxed_notification"
                android:drawableEnd="@drawable/ic_chevron_right"/>
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/data_management_button"
                style="@style/Theme.VocabyAndroid.ProfileButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/data_transfer"
                android:drawableStart="@drawable/ic_boxed_data_management"
                android:drawableEnd="@drawable/ic_chevron_right"/>
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/support_button"
                style="@style/Theme.VocabyAndroid.ProfileButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/nav_support"
                android:drawableStart="@drawable/ic_boxed_support"
                android:drawableEnd="@drawable/ic_chevron_right"/>
        </LinearLayout>
    </androidx.cardview.widget.CardView>
</LinearLayout>