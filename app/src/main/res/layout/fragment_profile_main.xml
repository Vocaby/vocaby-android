<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context=".ui.profile.ProfileHomeFragment">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginStart="@dimen/container_side_margin"
        android:layout_marginEnd="@dimen/container_side_margin">
        <TextView
            style="@style/Theme.VocabyAndroid.TextHeadline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/chart_header"
            android:textColor="@color/gray" />
        <Space
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />
        <TextView
            android:id="@+id/chart_placeholder_alert"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:textSize="10sp"
            android:fontFamily="@font/sourcesanspro_semibold"
            android:textColor="@color/colorHeadline"
            tools:ignore="SmallSp" />
        <View
            android:id="@+id/indicator"
            android:layout_width="6dp"
            android:layout_height="6dp"
            android:layout_marginStart="6dp"
            android:layout_gravity="center"
            android:background="@drawable/indicator"/>
    </LinearLayout>
    <include layout="@layout/chart_placeholder" />
    <LinearLayout
        android:id="@+id/chart_container"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        <TextView
            android:id="@+id/favorite_entry"
            style="@style/Theme.VocabyAndroid.TextHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="24sp"
            android:ellipsize="end"
            android:maxLines="1"
            android:layout_marginStart="@dimen/container_side_margin"
            android:layout_marginEnd="@dimen/container_side_margin" />
        <com.github.mikephil.charting.charts.BarChart
            android:id="@+id/bar_chart"
            android:layout_width="match_parent"
            android:layout_height="130dp"
            android:layout_gravity="center"
            android:layout_marginStart="@dimen/container_side_margin"
            android:layout_marginEnd="@dimen/container_side_margin" />
    </LinearLayout>

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/notification_button"
        style="@style/Theme.VocabyAndroid.ProfileButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/notifications"
        android:drawableStart="@drawable/ic_boxed_notification"
        android:drawableEnd="@drawable/ic_chevron_right"/>
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/data_management_button"
        style="@style/Theme.VocabyAndroid.ProfileButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/nav_data_management"
        android:drawableStart="@drawable/ic_boxed_data_management"
        android:drawableEnd="@drawable/ic_chevron_right"/>
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/support_button"
        style="@style/Theme.VocabyAndroid.ProfileButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/nav_support"
        android:drawableStart="@drawable/ic_boxed_support" />
    <Space
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:layout_weight="1" />
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/danger_zone_button"
        style="@style/Theme.VocabyAndroid.ProfileButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/nav_danger_zone"
        android:drawableStart="@drawable/ic_boxed_danger_zone"
        android:drawableEnd="@drawable/ic_chevron_right"/>
</LinearLayout>