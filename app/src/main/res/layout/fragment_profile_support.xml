<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/very_light_gray"
    android:orientation="vertical"
    android:clickable="true"
    tools:context=".feature_user.presentation.ui.SupportFragment">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingStart="@dimen/container_side_margin"
        android:paddingEnd="@dimen/container_side_margin"
        android:background="@drawable/box_bottom_stroke_gray">
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/back_button"
            style="@style/Theme.VocabyAndroid.NavButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:drawableStart="@drawable/ic_chevron_left"
            android:text="@string/back"
            android:layout_marginStart="-8dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/sourcesanspro_semibold"
            android:text="@string/nav_support"
            android:textColor="@color/black"
            android:textSize="14sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="@dimen/container_side_margin"
                android:background="@color/white"
                android:orientation="vertical">

                <TextView
                    style="@style/Theme.VocabyAndroid.TextHeadline"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="@dimen/container_side_margin"
                    android:paddingEnd="@dimen/container_side_margin"
                    android:text="@string/support_faq" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/faq_recyclerview"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipToPadding="false"
                    android:paddingTop="@dimen/header_gap"
                    android:paddingBottom="@dimen/container_side_margin"
                    android:paddingStart="@dimen/container_side_margin"
                    android:paddingEnd="@dimen/container_side_margin" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="@dimen/container_side_margin"
                android:paddingStart="@dimen/container_side_margin"
                android:paddingEnd="@dimen/container_side_margin"
                android:paddingBottom="@dimen/container_side_margin"
                android:orientation="vertical">
                <TextView
                    style="@style/Theme.VocabyAndroid.TextHeadline"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingBottom="@dimen/header_gap"
                    android:text="@string/contact_us" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/black"
                    android:fontFamily="@font/sourcesanspro_regular"
                    android:textSize="12sp"
                    android:text="@string/contact_us_body"/>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/container_side_margin"
                    android:layout_marginBottom="@dimen/container_side_margin"
                    android:fontFamily="@font/sourcesanspro_black"
                    android:textSize="14sp"
                    android:textAllCaps="false"
                    android:textColor="@color/colorPrimary"
                    android:text="@string/vocaby_email" />
                <TextView
                    style="@style/Theme.VocabyAndroid.TextHeadline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/header_gap"
                    android:text="@string/support_vocaby" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/black"
                    android:fontFamily="@font/sourcesanspro_regular"
                    android:textSize="12sp"
                    android:text="@string/support_vocaby_body"/>
                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Theme.VocabyAndroid.TextInputLayout"
                    android:id="@+id/feedback_input_type"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/container_gap_margin"
                    app:endIconTint="@color/nav_colors"
                    app:boxCornerRadiusTopStart="@dimen/radius"
                    app:boxCornerRadiusBottomEnd="@dimen/radius"
                    app:boxCornerRadiusBottomStart="@dimen/radius"
                    app:boxCornerRadiusTopEnd="@dimen/radius"
                    app:boxStrokeColor="@color/nav_colors"
                    app:boxStrokeWidth="1dp"
                    app:boxBackgroundColor="@color/light_gray"
                    app:hintAnimationEnabled="false"
                    app:hintEnabled="false"
                    app:boxStrokeWidthFocused="1dp">
                    <androidx.appcompat.widget.AppCompatAutoCompleteTextView
                        style="@style/Theme.VocabyAndroid.TextInputEditText"
                        android:id="@+id/autocomplete_text"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:inputType="none"
                        android:textColorHint="@color/gray"
                        android:hint="@string/enter_your_feedback"
                        android:editable="false"
                        android:layout_weight="1"
                        android:fontFamily="@font/sourcesanspro_black"
                        android:textSize="12sp"
                        android:textColor="@color/black"/>
                </com.google.android.material.textfield.TextInputLayout>
                <EditText
                    android:id="@+id/feedback_input_email"
                    android:background="@drawable/text_input_box"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textEmailAddress"
                    android:imeOptions="actionDone"
                    android:hint="@string/feedback_input_email"
                    android:padding="12dp"
                    android:textSize="12sp"
                    android:textColor="@color/black"
                    android:fontFamily="@font/sourcesanspro_regular"
                    android:layout_marginTop="@dimen/container_gap_margin"
                    android:autofillHints="Enter a pronunciation" />
                <EditText
                    android:id="@+id/feedback_input_content"
                    android:background="@drawable/text_input_box"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textMultiLine"
                    android:imeOptions="actionDone"
                    android:hint="@string/enter_your_feedback_message"
                    android:gravity="start"
                    android:padding="12dp"
                    android:lines="4"
                    android:textSize="12sp"
                    android:textColor="@color/black"
                    android:fontFamily="@font/sourcesanspro_regular"
                    android:layout_marginTop="@dimen/container_gap_margin"
                    android:autofillHints="Enter a pronunciation" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/feedback_input_submit"
                    style="@style/Theme.VocabyAndroid.Button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/container_gap_margin"
                    android:text="@string/submit_feedback" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="18dp"
                    android:layout_marginTop="6dp"
                    android:gravity="center_vertical|end"
                    android:orientation="horizontal">
                    <TextView
                        android:id="@+id/feedback_input_alert"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/colorHeadline"
                        android:fontFamily="@font/sourcesanspro_semibold"
                        android:textSize="12sp" />
                    <ProgressBar
                        android:id="@+id/submit_progress_bar"
                        style="?android:attr/progressBarStyle"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_marginStart="@dimen/container_gap_margin"
                        android:indeterminateTint="@color/colorPrimary"
                        android:visibility="gone" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>