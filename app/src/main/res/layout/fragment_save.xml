<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".feature_save.presentation.save.SaveFragment">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="@drawable/save_header"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView
            style="@style/Theme.VocabyAndroid.TextHeadline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/container_side_margin"
            android:drawablePadding="8dp"
            android:gravity="center"
            android:text="@string/nav_saves"
            android:textColor="@color/white"
            android:textSize="14sp"
            app:drawableStartCompat="@drawable/ic_vocaby_logo_sm" />

        <Space
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />
    </LinearLayout>
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/save_app_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:theme="@style/Theme.VocabyAndroid">
        <com.google.android.material.tabs.TabLayout
            android:id="@+id/save_tab"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            app:tabTextColor="@color/white"
            app:tabBackground="@color/colorPrimaryAccent"
            app:tabIndicatorColor="@color/colorPrimary"
            app:tabSelectedTextColor="@color/white"
            app:tabIndicatorHeight="2dp"
            app:tabTextAppearance="@style/Theme.VocabyAndroid.TextHeadline">
            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/all_saves" />
            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/collections" />
        </com.google.android.material.tabs.TabLayout>
    </com.google.android.material.appbar.AppBarLayout>
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/save_fragment_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>
</LinearLayout>