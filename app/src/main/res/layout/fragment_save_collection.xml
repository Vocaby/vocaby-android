<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/all_saves_app_bar"
        android:theme="@style/Theme.VocabyAndroid"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@color/white"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.cardview.widget.CardView
            android:id="@+id/all_saves"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/white"
            android:layout_marginTop="@dimen/container_side_margin"
            android:layout_marginStart="@dimen/container_side_margin"
            android:layout_marginEnd="@dimen/container_side_margin"
            app:layout_scrollFlags="scroll|enterAlways"
            app:cardCornerRadius="@dimen/radius"
            app:cardElevation="@dimen/card_elevation">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/box_white_stroked_green">
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/all_save_recycler_view"
                    android:layout_width="match_parent"
                    android:layout_height="120dp"
                    android:background="@drawable/box_bottom_stroke_gray"
                    android:textSize="12sp"
                    android:gravity="center"
                    android:paddingStart="@dimen/container_side_margin"
                    android:paddingEnd="@dimen/container_side_margin"
                    android:paddingTop="@dimen/container_gap_margin"
                    android:paddingBottom="@dimen/container_gap_margin"
                    android:textAllCaps="true"
                    android:textColor="@color/white" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:paddingTop="8dp"
                    android:paddingStart="@dimen/container_side_margin"
                    android:paddingEnd="@dimen/container_side_margin"
                    android:paddingBottom="8dp"
                    android:background="@drawable/box_gray_top_straight"
                    android:orientation="horizontal">
                    <TextView
                        android:id="@+id/collection_counter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/sourcesanspro_black"
                        android:textSize="12sp"
                        android:textColor="@color/black" />
                    <Space
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="1"/>
                    <TextView
                        android:id="@+id/word_box_tag"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/box_green"
                        android:padding="6dp"
                        android:text="All Saves"
                        android:layout_gravity="end"
                        android:fontFamily="@font/sourcesanspro_black"
                        android:textSize="11sp"
                        android:textColor="@color/colorPrimaryAccent" />
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </com.google.android.material.appbar.AppBarLayout>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/save_collection_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:background="@color/white"
        android:orientation="vertical"
        android:overScrollMode="never"
        android:paddingStart="@dimen/container_side_margin"
        android:paddingTop="@dimen/container_side_margin"
        android:paddingEnd="@dimen/container_side_margin"
        app:layout_behavior="@string/appbar_scrolling_view_behavior" />
    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/add_collection_button"
        android:theme="@style/Theme.VocabyAndroid"
        style="@style/Widget.App.ExtendedFloatingActionButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:layout_gravity="bottom|end"
        android:text="@string/add_save_collection"
        app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.VocabyAndroid.FAB"
        app:backgroundTint="@color/colorPrimary"
        app:layout_anchor="@id/save_collection_container"
        app:layout_anchorGravity="bottom|end"
        app:iconTint="@color/white"
        app:icon="@drawable/ic_add"
        app:iconPadding="4dp" />
</androidx.coordinatorlayout.widget.CoordinatorLayout>