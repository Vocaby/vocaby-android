<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".ui.DictionaryFragment">
    <LinearLayout
        android:id="@+id/vocaby_header"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:gravity="center_vertical"
        android:background="@color/white">

        <ImageView
            android:id="@+id/vocaby_header_logo"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginStart="@dimen/container_side_margin"
            android:contentDescription="@string/app_logo"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/ic_vocaby_logo" />

        <TextView
            android:id="@+id/header_text"
            style="@style/Theme.VocabyAndroid.TextHeadline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/app_name"
            android:textColor="@color/colorPrimary"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/header_dictionary"
            style="@style/Theme.VocabyAndroid.TextHeadline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dictionary_header_margin_before_slide"
            android:layout_marginStart="4dp"
            android:text="@string/dictionary_header"
            android:textColor="@color/colorPrimary"
            android:textSize="16sp" />

        <Space
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/header_dictionary_counter"
            style="@style/Theme.VocabyAndroid.TextHeadline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:textColor="@color/colorSecondary"
            android:textSize="12sp" />

        <TextView
            style="@style/Theme.VocabyAndroid.TextHeadline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/container_side_margin"
            android:textColor="@color/black"
            android:text="@string/entries_header"
            android:textSize="12sp" />
    </LinearLayout>
    <FrameLayout
        android:id="@+id/dictionary_fragment_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/very_light_gray" />
</LinearLayout>