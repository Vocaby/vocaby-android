<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.DictionaryFragment">
    <FrameLayout
        android:id="@+id/dictionary_fragment_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/vocaby_header"
        app:layout_constraintWidth_percent="0.92" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/vocaby_header"
        android:layout_width="0dp"
        android:layout_height="130dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/header_background"
            android:layout_width="0dp"
            android:layout_height="90dp"
            android:contentDescription="@string/gradient_bg"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/green_gradient" />

        <TextView
            android:id="@+id/header_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginTop="@dimen/container_side_margin"
            android:fontFamily="@font/sourcesanspro_semibold"
            android:text="@string/app_header"
            android:textColor="@color/white"
            android:textSize="20sp"
            app:layout_constraintStart_toEndOf="@+id/vocaby_header_logo"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/vocaby_header_logo"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginTop="@dimen/container_side_margin"
            android:layout_marginStart="@dimen/container_side_margin"
            android:contentDescription="@string/app_logo"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/logo_boxed" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <com.arlib.floatingsearchview.FloatingSearchView
        android:id="@+id/vocaby_search_bar"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:floatingSearch_searchBarMarginTop="64dp"
        app:floatingSearch_searchBarMarginLeft="@dimen/container_side_margin"
        app:floatingSearch_searchBarMarginRight="@dimen/container_side_margin"
        app:floatingSearch_close_search_on_keyboard_dismiss="true"
        app:floatingSearch_searchHint="@string/search_hint"
        app:floatingSearch_suggestionsListAnimDuration="250"
        app:floatingSearch_leftActionMode="showSearch"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>