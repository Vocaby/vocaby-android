<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="360dp"
    android:layout_height="wrap_content"
    android:layout_gravity="center_horizontal"
    app:cardCornerRadius="@dimen/radius"
    app:cardElevation="@dimen/card_elevation"
    app:cardUseCompatPadding="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/box_daily_entry"
        android:orientation="vertical">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="1dp"
            android:background="@drawable/box_gray_bottom_straight"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingTop="@dimen/card_content_margin"
            android:paddingBottom="@dimen/card_content_margin">
            <TextView
                android:id="@+id/entry_header"
                style="@style/Theme.VocabyAndroid.TextHeader"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginStart="@dimen/card_content_margin"
                android:layout_marginEnd="@dimen/card_content_margin"
                android:layout_marginTop="-4dp"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:hyphenationFrequency="full"
                android:maxLines="2"
                android:textColor="@color/black"
                app:autoSizeMinTextSize="16sp"
                app:autoSizeStepGranularity="1sp"
                app:autoSizeTextType="uniform" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="160dp"
            android:orientation="vertical">
            <TextView
                android:id="@+id/type"
                style="@style/Theme.VocabyAndroid.TextSubHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/card_content_margin"
                android:layout_marginTop="8dp"
                android:textColor="@color/colorPrimary" />

            <TextView
                android:id="@+id/card_definition"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/card_content_margin"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="@dimen/card_content_margin"
                android:ellipsize="end"
                android:maxLines="3"
                android:textColor="@color/black"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/card_sentence"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/card_content_margin"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="@dimen/card_content_margin"
                android:layout_marginBottom="8dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:textColor="@color/dark_gray"
                android:textSize="14sp" />

            <Space
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/word_box_tag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_margin="12dp"
                android:background="@drawable/box_green"
                android:fontFamily="@font/sourcesanspro_black"
                android:paddingStart="10dp"
                android:paddingTop="6dp"
                android:paddingEnd="10dp"
                android:paddingBottom="6dp"
                android:textAllCaps="true"
                android:textColor="@color/colorPrimaryAccent"
                android:textSize="10sp"
                tools:ignore="SmallSp" />
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>