<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/card_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:backgroundTint="@color/white"
    android:layout_marginStart="4dp"
    android:layout_marginEnd="4dp"
    android:layout_marginBottom="8dp"
    app:cardCornerRadius="@dimen/radius"
    app:cardElevation="0dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/box_white_stroked_green">
        <TextView
            android:id="@+id/collection_header"
            style="@style/Theme.VocabyAndroid.TextHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/box_white_bottom_straight"
            android:textSize="14sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:paddingTop="@dimen/container_gap_margin"
            android:paddingBottom="@dimen/container_gap_margin"
            android:layout_marginStart="@dimen/container_gap_margin"
            android:layout_marginEnd="@dimen/container_gap_margin"
            android:textAllCaps="false"
            android:textColor="@color/black" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/container_gap_margin"
            android:paddingEnd="@dimen/container_gap_margin"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:background="@drawable/box_white"
            android:backgroundTint="@color/very_light_gray"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/collection_counter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/sourcesanspro_regular"
                android:textSize="12sp"
                android:textColor="@color/black" />
            <Space
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />
            <ImageButton
                android:id="@+id/more_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@null"
                android:backgroundTint="@color/white"
                android:contentDescription="@string/unsave_button_desc"
                android:paddingTop="0dp"
                android:src="@drawable/ic_more" />
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>