<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/type_card"
    android:theme="@style/Theme.VocabyAndroid"
    android:layout_width="match_parent"
    android:layout_height="60dp"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_marginBottom="8dp"
    app:cardCornerRadius="@dimen/radius"
    app:strokeColor="@color/light_gray"
    app:strokeWidth="1dp">
    <LinearLayout
        android:id="@+id/card_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/white"
        android:orientation="horizontal"
        android:baselineAligned="false">
        <FrameLayout
            android:id="@+id/drag_handle"
            android:layout_width="60dp"
            android:layout_height="match_parent"
            android:background="@color/very_light_gray">
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:src="@drawable/ic_drag_handle"
                android:contentDescription="@string/drag_icon" />
        </FrameLayout>
        <TextView
            android:id="@+id/type_card_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="4dp"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="@dimen/container_side_margin"
            android:layout_gravity="center_vertical"
            android:textAllCaps="true"
            android:textSize="18sp"
            android:fontFamily="@font/playfairdisplay_bold"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="@color/black" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>