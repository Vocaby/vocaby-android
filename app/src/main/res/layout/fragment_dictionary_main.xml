<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:background="@color/very_light_gray">
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/app_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:theme="@style/Theme.VocabyAndroid"
        app:elevation="0dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/box_white_bottom_stroke_gray"
            android:orientation="vertical"
            app:layout_scrollFlags="scroll|exitUntilCollapsed|snap">
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/add_entry_button"
                style="@style/Theme.VocabyAndroid.ProfileButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:drawableStart="@drawable/ic_boxed_add"
                android:text="@string/add_entry" />
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/edit_dictionary_button"
                style="@style/Theme.VocabyAndroid.ProfileButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:drawableStart="@drawable/ic_boxed_edit"
                android:text="@string/edit_dictionary" />
        </LinearLayout>
    </com.google.android.material.appbar.AppBarLayout>
    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/search_button"
        style="@style/Widget.App.ExtendedFloatingActionButton"
        android:layout_width="94dp"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:text="@string/search"
        android:theme="@style/Theme.VocabyAndroid"
        app:backgroundTint="@color/colorPrimary"
        app:elevation="1dp"
        app:icon="@drawable/ic_search"
        app:iconPadding="0dp"
        app:iconTint="@color/white"
        app:layout_anchor="@id/dictionary_home_container"
        app:layout_anchorGravity="bottom|end"
        app:layout_behavior="com.google.android.material.behavior.HideBottomViewOnScrollBehavior"
        app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.VocabyAndroid.FAB" />
    <androidx.core.widget.NestedScrollView
        android:id="@+id/dictionary_home_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:overScrollMode="never"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardElevation="1dp"
                android:layout_marginBottom="@dimen/container_gap_margin">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="@dimen/container_side_margin"
                    android:paddingBottom="@dimen/container_side_margin"
                    android:background="@color/white"
                    android:orientation="vertical">
                    <TextView
                        style="@style/Theme.VocabyAndroid.TextHeadline"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/container_side_margin"
                        android:layout_marginEnd="@dimen/container_side_margin"
                        android:layout_marginBottom="@dimen/header_gap"
                        android:text="@string/history" />
                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <TextView
                            android:id="@+id/empty_card"
                            style="@style/Theme.VocabyAndroid.TextHeadline"
                            android:layout_width="200dp"
                            android:layout_height="74dp"
                            android:layout_marginStart="@dimen/container_side_margin"
                            android:layout_marginEnd="@dimen/container_side_margin"
                            android:background="@drawable/box_gray_stroked_dash_gray"
                            android:gravity="center"
                            android:text="@string/empty_history"
                            android:textColor="@color/gray" />
                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/search_history_container"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:nestedScrollingEnabled="false"
                            android:clipToPadding="false"
                            android:orientation="horizontal"
                            android:paddingStart="@dimen/container_side_margin"
                            android:paddingEnd="@dimen/container_side_margin"
                            android:overScrollMode="never"/>
                    </FrameLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardElevation="1dp"
                android:layout_marginBottom="@dimen/container_gap_margin">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@color/white"
                    android:paddingTop="@dimen/container_side_margin"
                    android:paddingBottom="@dimen/container_side_margin">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:layout_marginStart="@dimen/container_side_margin"
                    android:layout_marginEnd="@dimen/container_side_margin"
                    android:layout_marginBottom="@dimen/header_gap">
                    <TextView
                        style="@style/Theme.VocabyAndroid.TextHeadline"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/eod" />
                    <Space
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"/>
                    <TextView
                        android:id="@+id/daily_pick_alert"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:fontFamily="@font/sourcesanspro_semibold"
                        android:textColor="@color/colorPrimary"
                        android:textSize="10sp"
                        android:visibility="invisible"
                        android:text="@string/picking_an_entry"
                        tools:ignore="SmallSp" />
                </LinearLayout>
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <include layout="@layout/placeholder_eod" />
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/eod_recycler_view"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clipToPadding="false"
                        android:paddingStart="@dimen/container_side_margin"
                        android:paddingEnd="@dimen/container_side_margin"
                        android:visibility="invisible"
                        android:nestedScrollingEnabled="false"
                        android:overScrollMode="never"/>
                </FrameLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="@dimen/container_gap_margin"
                    android:layout_marginStart="@dimen/container_side_margin"
                    android:layout_marginEnd="@dimen/container_side_margin">
                    <TextView
                        style="@style/Theme.VocabyAndroid.TextSubHeader"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/header_gap"
                        android:text="@string/previous_selection" />
                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="44dp"
                        android:background="@drawable/box_gray_stroked_gray">
                        <TextView
                            android:id="@+id/previous_selection_empty_text"
                            style="@style/Theme.VocabyAndroid.TextHeadline"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:textColor="@color/gray"
                            android:text="@string/no_previous_selection" />
                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/previous_selection_recycler_view"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:nestedScrollingEnabled="false"
                            android:overScrollMode="never"/>
                    </FrameLayout>
                </LinearLayout>
            </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>