<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:autofit="http://schemas.android.com/tools"
    android:id="@+id/card_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:backgroundTint="@color/white"
    android:layout_marginStart="@dimen/container_side_margin"
    android:layout_marginEnd="@dimen/container_side_margin"
    android:layout_marginBottom="@dimen/container_gap_margin"
    app:cardCornerRadius="0dp"
    app:cardElevation="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/box_white_stroked_gray">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="@dimen/container_gap_margin"
            android:paddingBottom="@dimen/container_gap_margin"
            android:paddingStart="@dimen/container_side_margin"
            android:paddingEnd="@dimen/container_side_margin"
            android:orientation="vertical">
            <TextView
                style="@style/Theme.VocabyAndroid.TextHeadline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/entry"
                android:textColor="@color/gray"
                android:textSize="10sp"
                autofit:ignore="SmallSp" />

            <TextView
                android:id="@+id/custom_entry_item_header"
                style="@style/Theme.VocabyAndroid.TextHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:hyphenationFrequency="full"
                android:textSize="18sp"
                android:textAllCaps="true"
                android:textColor="@color/black" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/container_side_margin"
            android:paddingEnd="18dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:background="@drawable/custom_entry_item_bar"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/custom_entry_item_updated"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/sourcesanspro_regular"
                android:textSize="14sp"
                android:textAllCaps="true"
                android:textColor="@color/black" />
            <Space
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />
            <ImageButton
                android:id="@+id/more_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@null"
                android:backgroundTint="@color/white"
                android:contentDescription="@string/unsave_button_desc"
                android:paddingTop="0dp"
                android:src="@drawable/ic_more" />
        </LinearLayout>

    </LinearLayout>
</androidx.cardview.widget.CardView>