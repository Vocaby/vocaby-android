<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/rounded_background"
    android:clickable="true"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:orientation="vertical"
    xmlns:android="http://schemas.android.com/apk/res/android"
    tools:context=".ui.customentry.EntryGroupBuilderActivity">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/box_bottom_stroke_gray">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/back_button"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/sourcesanspro_semibold"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:text="@string/nav_close"
                android:textAllCaps="false"
                android:textColor="@color/black"
                android:textSize="14sp"
                tools:ignore="SmallSp" />

            <Space
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/custom_group_activity_header"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/sourcesanspro_semibold"
                android:textColor="@color/black"
                android:textSize="14sp" />

            <Space
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/save_button"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/sourcesanspro_semibold"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:text="@string/nav_save"
                android:textAllCaps="false"
                android:textColor="@color/colorPrimaryAccent"
                android:textSize="14sp"
                tools:ignore="SmallSp" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        style="@style/Theme.VocabyAndroid.TextHeadline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/container_side_margin"
        android:layout_marginStart="@dimen/container_side_margin"
        android:layout_marginEnd="@dimen/container_side_margin"
        android:text="@string/type"
        android:textSize="14sp"
        android:textColor="@color/colorPrimaryAccent"/>

    <TextView
        style="@style/Theme.VocabyAndroid.TextHeader"
        android:id="@+id/type_header"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/container_side_margin"
        android:layout_marginEnd="@dimen/container_side_margin"
        android:textColor="@color/black"
        android:textSize="34sp"
        android:textAllCaps="true" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/container_gap_margin"
        android:layout_marginStart="@dimen/container_side_margin"
        android:layout_marginTop="@dimen/container_gap_margin"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView
            style="@style/Theme.VocabyAndroid.TextHeadline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/definition_header_singular"
            android:textColor="@color/colorPrimaryAccent"/>

        <TextView
            android:id="@+id/definition_add_alert"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:textColor="@color/colorHeadline"
            android:fontFamily="@font/sourcesanspro_semibold"
            android:text="@string/definition_add_alert"
            android:visibility="invisible"
            android:textSize="12sp" />
    </LinearLayout>
    <com.google.android.material.button.MaterialButton
        android:id="@+id/add_definition_button"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginStart="@dimen/container_side_margin"
        android:layout_marginEnd="@dimen/container_side_margin"
        android:background="@drawable/rounded_background"
        android:text="@string/custom_definition_add_button"
        android:textSize="12sp"
        android:textColor="@color/dark_gray"
        android:textAllCaps="false"
        android:fontFamily="@font/sourcesanspro_semibold"
        app:backgroundTint="@color/white"
        app:icon="@drawable/ic_add"
        app:iconGravity="textStart"
        app:iconTint="@color/dark_gray"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/custom_entry_definition_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:requiresFadingEdge="none"
        android:overScrollMode="never"
        android:paddingTop="8dp"
        android:paddingStart="@dimen/container_side_margin"
        android:paddingEnd="@dimen/container_side_margin"/>
</LinearLayout>