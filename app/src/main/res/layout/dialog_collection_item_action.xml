<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/rounded_background"
    android:orientation="vertical"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:background="@drawable/nav_header"
        android:padding="16dp">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/sourcesanspro_semibold"
            android:text="@string/update_collection"
            android:textColor="@color/black"
            android:textSize="14sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/box_top_stroke_white"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/container_side_margin"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/container_side_margin"
            android:layout_marginEnd="@dimen/container_side_margin"
            android:layout_marginBottom="8dp"
            android:layout_marginStart="@dimen/container_side_margin"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/header"
                style="@style/Theme.VocabyAndroid.TextHeadline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/dark_gray"
                android:labelFor="@+id/definition_edit"
                android:text="@string/actions"
                android:textSize="12sp"/>

            <TextView
                android:id="@+id/header_alert"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:fontFamily="@font/sourcesanspro_semibold"
                android:textColor="@color/colorHeadline"
                android:visibility="invisible" />
        </LinearLayout>
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/edit_collection_name_button"
            style="@style/Theme.VocabyAndroid.ProfileButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/collection_rename"
            android:drawableStart="@drawable/ic_boxed_edit" />
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/delete_collection_button"
            style="@style/Theme.VocabyAndroid.ProfileButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="@string/collection_delete"
            android:drawableStart="@drawable/ic_boxed_danger_zone" />
    </LinearLayout>
</LinearLayout>