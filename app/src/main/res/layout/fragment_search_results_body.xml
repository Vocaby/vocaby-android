<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingStart="@dimen/container_side_margin"
    android:paddingEnd="@dimen/container_side_margin"
    android:clipToPadding="false"
    xmlns:autofit="http://schemas.android.com/apk/res-auto"
    android:background="@color/white"
    tools:context=".ui.dictionary.SearchResultsBodyFragment">

    <LinearLayout
        android:id="@+id/word_box"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingTop="6dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <me.grantland.widget.AutofitTextView
            android:id="@+id/word_header"
            style="@style/Theme.VocabyAndroid.TextHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:maxLines="3"
            android:textAllCaps="true"
            android:textColor="@color/colorPrimaryAccent"
            android:textSize="32sp"
            autofit:minTextSize="14sp" />

        <TextView
            android:id="@+id/pronunciation"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            android:fontFamily="@font/sourcesanspro_black"
            android:gravity="center"
            android:textColor="@color/black"
            android:textSize="12sp"
            android:visibility="gone" />
    </LinearLayout>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/definitions_recycler_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:layout_marginTop="16dp"
        android:background="@drawable/definition_container_background"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/word_box" />
</androidx.constraintlayout.widget.ConstraintLayout>