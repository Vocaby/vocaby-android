<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:background="@color/white"
    tools:context=".feature_dictionary.presentation.ui.SearchResultsBodyFragment">
    <LinearLayout
        android:id="@+id/entry_box"
        android:layout_width="match_parent"
        android:layout_height="90dp"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:background="@drawable/box_bottom_stroke_gray">
        <TextView
            android:id="@+id/entry_header"
            style="@style/Theme.VocabyAndroid.TextHeader"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:gravity="center"
            android:maxLines="3"
            android:textAllCaps="true"
            android:textColor="@color/colorPrimaryAccent"
            android:layout_marginStart="@dimen/container_side_margin"
            android:layout_marginEnd="@dimen/container_side_margin"
            app:autoSizeMinTextSize="12sp"
            app:autoSizeStepGranularity="1sp"
            app:autoSizeTextType="uniform" />

        <HorizontalScrollView
            android:id="@+id/pronunciation_scroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollIndicators="none"
            android:scrollbars="none"
            android:scrollbarThumbVertical="@null"
            android:visibility="gone"
            android:clipToPadding="false"
            android:paddingStart="@dimen/container_side_margin"
            android:paddingEnd="@dimen/container_side_margin"
            android:fillViewport="true">
            <TextView
                android:id="@+id/pronunciation"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/sourcesanspro_semibold"
                android:gravity="center"
                android:scrollIndicators="none"
                android:scrollbars="none"
                android:scrollbarThumbVertical="@null"
                android:textColor="@color/black"
                android:textSize="12sp" />
        </HorizontalScrollView>
    </LinearLayout>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/definitions_recycler_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:background="@color/white"
        android:paddingStart="@dimen/container_side_margin"
        android:paddingEnd="@dimen/container_side_margin"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/word_box" />
</LinearLayout>