<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingStart="@dimen/container_side_margin"
    android:paddingEnd="@dimen/container_side_margin"
    android:clipToPadding="false"
    xmlns:autofit="http://schemas.android.com/apk/res-auto"
    android:background="@color/white"
    tools:context=".ui.dictionary.SearchResultsBodyFragment">
    <LinearLayout
        android:id="@+id/word_box"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="84dp"
        android:background="@drawable/box_entry_header"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingTop="@dimen/flag_offset"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/linearLayout">

        <me.grantland.widget.AutofitTextView
            android:id="@+id/word_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/Theme.VocabyAndroid.TextHeader"
            android:layout_marginTop="-4dp"
            android:maxLines="4"
            autofit:minTextSize="12sp"
            android:textSize="24sp"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            android:textAllCaps="true"
            android:gravity="center"
            android:textColor="@color/colorPrimaryAccent"/>

        <TextView
            android:id="@+id/pronunciation"
            android:fontFamily="@font/sourcesanspro_black"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:visibility="gone"
            android:textColor="@color/black" />
    </LinearLayout>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/definitions_recycler_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />
</LinearLayout>