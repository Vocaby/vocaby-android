<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.customentry.MyEntryFragment"
    android:orientation="vertical"
    android:background="@color/very_light_gray">

    <FrameLayout
        android:id="@+id/vocaby_header"
        android:layout_width="match_parent"
        android:layout_height="104dp"
        android:paddingTop="12dp"
        android:background="@color/colorPrimaryAccent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:layout_marginEnd="@dimen/container_side_margin"
            android:layout_marginStart="@dimen/container_side_margin"
            android:orientation="horizontal">
            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="@string/app_logo"
                app:srcCompat="@drawable/ic_vocaby_logo" />

            <TextView
                style="@style/Theme.VocabyAndroid.TextHeadline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/nav_custom_entries"
                android:textColor="@color/white"
                android:textSize="14sp" />

            <Space
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

            <ProgressBar
                android:id="@+id/progress_bar"
                style="?android:attr/progressBarStyle"
                android:visibility="gone"
                android:indeterminateTint="@color/colorPrimary"
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:layout_weight="1" />

            <Space
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/entry_count"
                style="@style/Theme.VocabyAndroid.TextHeadline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:text="@string/zero"
                android:textColor="@color/white"
                android:textSize="14sp" />

            <TextView
                style="@style/Theme.VocabyAndroid.TextHeadline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/custom_entries"
                android:textColor="@color/white"
                android:textSize="12sp" />
        </LinearLayout>
    </FrameLayout>

    <LinearLayout
        android:id="@+id/empty_card"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:background="@drawable/box_gray_stroked_dash_gray"
        android:gravity="center"
        android:orientation="horizontal"
        android:visibility="invisible"
        android:layout_marginTop="@dimen/container_side_margin"
        android:layout_marginStart="@dimen/container_side_margin"
        android:layout_marginEnd="@dimen/container_side_margin"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/vocaby_header">

        <TextView
            style="@style/Theme.VocabyAndroid.TextHeadline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/empty_custom_entry"
            android:textAllCaps="true"
            android:textColor="@color/gray" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/fetch_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="140dp"
        android:layout_height="wrap_content"
        android:indeterminate="true"
        android:indeterminateTint="@color/colorPrimary"
        android:scaleY="1.2"
        android:layout_marginTop="@dimen/container_side_margin"
        android:visibility="visible"
        app:layout_constraintVertical_bias="0"
        app:layout_constraintBottom_toBottomOf="@+id/custom_entry_container"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/vocaby_header" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/custom_entry_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:orientation="vertical"
        android:paddingBottom="54dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/vocaby_header" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/add_entry_button"
        style="@style/Theme.VocabyAndroid.Button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:textSize="12sp"
        android:text="@string/add_dictionary_entry"
        android:drawableStart="@drawable/ic_add"
        android:drawablePadding="4dp"
        app:layout_constraintBottom_toBottomOf="@+id/custom_entry_container"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/empty_card"
        app:layout_constraintVertical_bias="1.0" />

    <com.arlib.floatingsearchview.FloatingSearchView
        android:id="@+id/vocaby_search"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:floatingSearch_dismissOnOutsideTouch="true"
        app:floatingSearch_hintTextColor="@color/dark_gray"
        app:floatingSearch_close_search_on_keyboard_dismiss="false"
        app:floatingSearch_dimBackground="false"
        app:floatingSearch_leftActionMode="showSearch"
        app:floatingSearch_searchBarMarginLeft="@dimen/container_side_margin"
        app:floatingSearch_searchBarMarginRight="@dimen/container_side_margin"
        app:floatingSearch_searchBarMarginTop="38dp"
        app:floatingSearch_searchHint="@string/search_custom_entry_hint"
        app:floatingSearch_suggestionsListAnimDuration="200"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>