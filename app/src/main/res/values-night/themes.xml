<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.VocabyAndroid.Splash" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:windowBackground">@drawable/splash</item>
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryVariant">@color/colorPrimary</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">@color/white</item>

    </style>

    <!-- Base application theme. -->
    <style name="Theme.VocabyAndroid" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryVariant">@color/colorPrimary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="android:windowBackground">@color/white</item>

        <!-- Status bar color. -->
        <item name="android:statusBarColor" tools:targetApi="l">?attr/colorPrimaryVariant</item>

        <item name="preferenceTheme">@style/AppTheme.PreferenceThemeOverlay</item>

        <item name="colorAccent">@color/colorPrimary</item>

        <item name="android:fontFamily">@font/sourcesanspro_regular</item>
        <item name="android:textColor">@color/black</item>
    </style>

    <style name="AppTheme.PreferenceThemeOverlay" parent="@style/PreferenceThemeOverlay">
        <item name="android:layout">@layout/notification_settings</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:textColorPrimary">@color/black</item>
    </style>

    <style name="Theme.VocabyAndroid.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="Theme.VocabyAndroid.ProfileButton" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:background">?attr/selectableItemBackground</item>
        <item name="iconTint">@color/colorPrimary</item>
        <item name="fontFamily">@font/sourcesanspro_semibold</item>
        <item name="android:textSize">18sp</item>
        <item name="android:paddingBottom">18dp</item>
        <item name="android:paddingTop">18dp</item>
        <item name="android:textColor">@color/colorPrimary</item>
        <item name="textAllCaps">false</item>
        <item name="android:drawablePadding">28dp</item>
        <item name="android:paddingLeft">32dp</item>
        <item name="android:gravity">left|center_vertical</item>
    </style>

    <style name="Theme.VocabyAndroid.AppBarOverlay" parent="ThemeOverlay.AppCompat.Dark.ActionBar" />

    <style name="Theme.VocabyAndroid.PopupOverlay" parent="ThemeOverlay.AppCompat.Light" />
</resources>